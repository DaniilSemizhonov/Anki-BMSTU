# Copy to .env in the repository root. Compose reads this file automatically.
ANKI_PUBLIC_URL=https://anki.example.com
# Set your own password before starting; at least 12 characters.
ANKI_WEB_PASSWORD=
ANKI_TELEGRAM_BOT_TOKEN=
ANKI_TELEGRAM_USER_ID=
TZ=Europe/Moscow
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Only required when using compose.npm.yaml.
NPM_NETWORK=
